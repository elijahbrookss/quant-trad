          "rawSql": "WITH p AS (SELECT sampled_at,database_size_bytes FROM observability_metrics.database_capacity_samples WHERE $__timeFilter(sampled_at)), b AS (SELECT min(sampled_at) first_at,max(sampled_at) last_at FROM p), v AS (SELECT (SELECT database_size_bytes FROM p ORDER BY sampled_at LIMIT 1) first_bytes,(SELECT database_size_bytes FROM p ORDER BY sampled_at DESC LIMIT 1) last_bytes) SELECT b.last_at AS time,CASE WHEN EXTRACT(EPOCH FROM (b.last_at-b.first_at))>0 THEN (v.last_bytes-v.first_bytes)::double precision/EXTRACT(EPOCH FROM (b.last_at-b.first_at)) ELSE 0 END value FROM b CROSS JOIN v;",
          "refId": "A"
