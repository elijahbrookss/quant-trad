      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT * FROM observability_metrics.database_relation_capacity_samples WHERE $__timeFilter(sampled_at) AND schema_name ~ '${schema:regex}' AND relation_name ~ '${relation:regex}'), f AS (SELECT DISTINCT ON(schema_name,relation_name) schema_name,relation_name,sampled_at,total_bytes,estimated_live_rows FROM s ORDER BY schema_name,relation_name,sampled_at), l AS (SELECT DISTINCT ON(schema_name,relation_name) schema_name,relation_name,sampled_at,total_bytes,estimated_live_rows FROM s ORDER BY schema_name,relation_name,sampled_at DESC) SELECT l.schema_name,l.relation_name,pg_size_pretty(l.total_bytes) current_size,pg_size_pretty(l.total_bytes-f.total_bytes) growth,l.estimated_live_rows-f.estimated_live_rows row_growth,ROUND(CASE WHEN EXTRACT(EPOCH FROM(l.sampled_at-f.sampled_at))>0 THEN (l.total_bytes-f.total_bytes)::numeric/EXTRACT(EPOCH FROM(l.sampled_at-f.sampled_at)) ELSE 0 END,2) bytes_per_second FROM l JOIN f USING(schema_name,relation_name) ORDER BY l.total_bytes-f.total_bytes DESC LIMIT 50;",
          "refId": "A"
        }
      ],
      "title": "Relation growth over selected range",
      "type": "table"
