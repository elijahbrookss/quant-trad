          "rawSql": "WITH l AS (SELECT max(sampled_at) sampled_at FROM observability_metrics.database_relation_capacity_samples WHERE $__timeFilter(sampled_at)) SELECT s.schema_name,s.relation_name,s.relation_kind,pg_size_pretty(s.total_bytes) total,pg_size_pretty(s.table_bytes) table_data,pg_size_pretty(s.index_bytes) indexes,s.estimated_live_rows,s.estimated_dead_rows FROM observability_metrics.database_relation_capacity_samples s JOIN l USING(sampled_at) WHERE s.schema_name ~ '${schema:regex}' AND s.relation_name ~ '${relation:regex}' ORDER BY s.total_bytes DESC LIMIT 50;",
          "refId": "A"
