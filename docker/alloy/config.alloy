logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "quanttrad" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "quanttrad_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_loki_job"]
    regex         = "quanttrad"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_loki_job"]
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_docker_container_label_loki_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_quanttrad_runtime"]
    target_label  = "runtime"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    action = "labeldrop"
    regex  = "__meta_docker_container_label_(.+)"
  }

  rule {
    action = "labeldrop"
    regex  = "__meta_docker_container_(id|image|name)"
  }
}

loki.source.docker "quanttrad" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.quanttrad.targets
  labels        = {}
  relabel_rules = discovery.relabel.quanttrad_logs.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Optional clock-health overlay exposes only the non-secret JSONL export.
local.file_match "clock_health" {
  path_targets = [{"__path__" = "/run/qt-clock-health/clock-health.jsonl", "job" = "quanttrad", "service" = "clock-health"}]
  sync_period = "15s"
}

loki.source.file "clock_health" {
  targets    = local.file_match.clock_health.targets
  forward_to = [loki.process.clock_health.receiver]
}

loki.process "clock_health" {
  stage.json {
    expressions = {observed_at = "observed_at"}
    drop_malformed = true
  }
  // Timestamp parsing failure otherwise retains scrape time. Drop invalid
  // evidence first so a malformed/replayed healthy record cannot look fresh.
  stage.template {
    source = "clock_timestamp_valid"
    template = `{{ if kindIs "string" .observed_at }}{{ $parsed := toDate "2006-01-02T15:04:05.999999999Z07:00" .observed_at }}{{ if gt $parsed.Unix 0 }}true{{ else }}false{{ end }}{{ else }}false{{ end }}`
  }
  stage.drop {
    source = "clock_timestamp_valid"
    value = "false"
  }
  // File replay must retain sample time rather than look like fresh health.
  stage.timestamp {
    source = "observed_at"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }
  forward_to = [loki.write.local.receiver]
}
