{
  "$id": "https://quant-trad.local/schemas/assurance-cleanup-recovery-report.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_id": {
      "pattern": "^[a-z][a-z0-9-]{2,127}$",
      "type": "string"
    },
    "attestation_emitted": {
      "const": false
    },
    "attestation_id": {
      "$ref": "#/$defs/attestationId"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    },
    "control_plane_identity_sha256": {
      "$ref": "#/$defs/hash"
    },
    "environment_instance_id": {
      "pattern": "^[a-z][a-z0-9-]{7,127}$",
      "type": "string"
    },
    "execution_admission_archive_sha256": {
      "$ref": "#/$defs/hash"
    },
    "execution_admission_sha256": {
      "$ref": "#/$defs/hash"
    },
    "execution_draft": {
      "$ref": "#/$defs/artifactRef"
    },
    "finalizable": {
      "const": false
    },
    "nonfinalizable": {
      "const": true
    },
    "profile_id": {
      "$ref": "#/$defs/profileId"
    },
    "recovery_attempt_id": {
      "$ref": "#/$defs/recoveryAttemptId"
    },
    "recovery_intent": {
      "$ref": "#/$defs/recoveryIntentRef"
    },
    "recovery_state": {
      "enum": [
        "cleanup_incomplete",
        "cleanup_verified"
      ]
    },
    "schema_version": {
      "const": "qt.assurance_cleanup_recovery_report.v1"
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "source_snapshot_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "required": [
    "schema_version",
    "source_commit",
    "attestation_id",
    "profile_id",
    "admission_id",
    "environment_instance_id",
    "control_plane_identity_sha256",
    "source_snapshot_sha256",
    "execution_admission_sha256",
    "execution_admission_archive_sha256",
    "execution_draft",
    "recovery_attempt_id",
    "recovery_intent",
    "finalizable",
    "nonfinalizable",
    "attestation_emitted",
    "recovery_state",
    "cleanup"
  ],
  "title": "QT Assurance Cleanup Recovery Report v1",
  "type": "object",
  "$defs": {
    "artifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^docs/assurance/guarantees/evidence/QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+/_environments/[a-z][a-z0-9-]*/execution_draft-001-profile\\.json$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "attestationId": {
      "pattern": "^QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+$",
      "type": "string"
    },
    "cleanup": {
      "additionalProperties": false,
      "properties": {
        "cleanup_completed": {
          "type": "boolean"
        },
        "exit_code": {
          "minimum": 0,
          "type": "integer"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "label_query_remaining": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "redaction_applied": {
          "type": "boolean"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/resourceDisposition"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "stderr": {
          "type": "string"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/hash"
        },
        "stdout": {
          "type": "string"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "started_at",
        "finished_at",
        "exit_code",
        "cleanup_completed",
        "stdout",
        "stdout_sha256",
        "stderr",
        "stderr_sha256",
        "redaction_applied",
        "resources",
        "label_query_remaining"
      ],
      "type": "object"
    },
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profileId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "recoveryAttemptId": {
      "pattern": "^QT-REC-[0-9a-f]{24}$",
      "type": "string"
    },
    "recoveryIntentRef": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "minLength": 1,
          "pattern": "^[^/\\\\]+\\.pending$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "file_name",
        "sha256"
      ],
      "type": "object"
    },
    "resourceDisposition": {
      "additionalProperties": false,
      "properties": {
        "absent": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "container",
            "database",
            "network",
            "private_residue",
            "published_endpoint",
            "source_snapshot",
            "temporary_secret_file",
            "volume"
          ]
        },
        "logical_name": {
          "minLength": 1,
          "type": "string"
        },
        "runtime_identity": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "logical_name",
        "runtime_identity",
        "absent"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  }
}
