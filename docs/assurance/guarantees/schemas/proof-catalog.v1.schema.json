{
  "$id": "https://quant-trad.local/schemas/guarantee-proof-catalog.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment_profiles": {
      "items": {
        "$ref": "#/$defs/environmentProfile"
      },
      "minItems": 1,
      "type": "array"
    },
    "proofs": {
      "items": {
        "$ref": "#/$defs/proof"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "qt.guarantee_proof_catalog.v1"
    }
  },
  "required": [
    "schema_version",
    "environment_profiles",
    "proofs"
  ],
  "title": "QT Guarantee Proof Catalog v1",
  "type": "object",
  "$defs": {
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "guarantee_id": {
          "pattern": "^QT-GUAR-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
          "type": "string"
        },
        "required_for_full_attestation": {
          "type": "boolean"
        },
        "strength": {
          "enum": [
            "complete",
            "partial",
            "supporting"
          ]
        }
      },
      "required": [
        "guarantee_id",
        "strength",
        "required_for_full_attestation"
      ],
      "type": "object"
    },
    "environmentProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "lockfiles": {
          "items": {
            "$ref": "#/$defs/repoPath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "node": {
          "minLength": 1,
          "type": "string"
        },
        "python": {
          "minLength": 1,
          "type": "string"
        },
        "required_services": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "python",
        "lockfiles",
        "required_services"
      ],
      "type": "object"
    },
    "eventTransport": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/repoPath"
            },
            {
              "pattern": "\\.mjs$"
            }
          ]
        },
        "schema_version": {
          "const": "qt.node_test_events.v1"
        }
      },
      "required": [
        "path",
        "schema_version"
      ],
      "type": "object"
    },
    "heading": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "heading"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    "lineRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "line_range"
        },
        "start": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "type": "object"
    },
    "locator": {
      "oneOf": [
        {
          "$ref": "#/$defs/lineRange"
        },
        {
          "$ref": "#/$defs/heading"
        }
      ]
    },
    "manualRunner": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "manual"
        },
        "procedure_ref": {
          "additionalProperties": false,
          "properties": {
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "path": {
              "$ref": "#/$defs/repoPath"
            }
          },
          "required": [
            "path",
            "locator"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "procedure_ref"
      ],
      "type": "object"
    },
    "makeRunner": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "make_target"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "variables": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "type": "object"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "type": "object"
    },
    "nodeRunner": {
      "additionalProperties": false,
      "properties": {
        "event_transport": {
          "$ref": "#/$defs/eventTransport"
        },
        "expected_test_names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "expected_excluded_nonmatch_count": {
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/repoPath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "const": "node_test"
        },
        "name_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "files",
        "event_transport",
        "expected_test_names",
        "expected_excluded_nonmatch_count"
      ],
      "type": "object"
    },
    "proof": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "items": {
            "$ref": "#/$defs/coverage"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "environment_profile_id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "id": {
          "pattern": "^QT-PROOF-[0-9]{3}$",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "active",
            "proposed",
            "superseded",
            "retired"
          ]
        },
        "proof_kind": {
          "enum": [
            "automated_test",
            "database_integration",
            "static_validation",
            "manual_procedure"
          ]
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "timeout_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "lifecycle",
        "proof_kind",
        "environment_profile_id",
        "runner",
        "timeout_seconds",
        "coverage"
      ],
      "type": "object"
    },
    "pytestRunner": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pytest"
        },
        "selectors": {
          "items": {
            "pattern": "^[^:]+\\.py::.+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "selectors"
      ],
      "type": "object"
    },
    "pythonRunner": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "const": "python_script"
        },
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/repoPath"
            },
            {
              "pattern": "\\.py$"
            }
          ]
        }
      },
      "required": [
        "kind",
        "path",
        "args"
      ],
      "type": "object"
    },
    "repoPath": {
      "minLength": 1,
      "not": {
        "pattern": "(?:^/|\\\\|(?:^|/)\\.\\.(?:/|$))"
      },
      "type": "string"
    },
    "runner": {
      "oneOf": [
        {
          "$ref": "#/$defs/pytestRunner"
        },
        {
          "$ref": "#/$defs/nodeRunner"
        },
        {
          "$ref": "#/$defs/vitestRunner"
        },
        {
          "$ref": "#/$defs/pythonRunner"
        },
        {
          "$ref": "#/$defs/makeRunner"
        },
        {
          "$ref": "#/$defs/manualRunner"
        }
      ]
    },
    "vitestRunner": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/repoPath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "const": "vitest"
        },
        "name_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "files"
      ],
      "type": "object"
    }
  }
}
