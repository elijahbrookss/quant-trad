{
  "$id": "https://quant-trad.local/schemas/guarantee-registry.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"scope": {"properties": {"phase": {"const": "phase_2a_calibration"}}}}},
      "then": {
        "properties": {
          "guarantees": {"maxItems": 15, "minItems": 10},
          "scope": {"properties": {
            "included_candidate_ids": {"maxItems": 15, "minItems": 10},
            "whole_system_classification_complete": {"const": false}
          }}
        }
      }
    },
    {
      "if": {"properties": {"scope": {"properties": {"whole_system_classification_complete": {"const": true}}}}},
      "then": {"properties": {
        "guarantees": {"items": {"allOf": [{
          "if": {"properties": {"registry_disposition": {"enum": ["partially_enforced", "contradicted"]}}},
          "then": {"properties": {
            "remediation_refs": {"minItems": 1},
            "remediation_status": {"enum": ["recorded", "resolved"]}
          }}
        }]}},
        "scope": {"properties": {
          "included_candidate_ids": {"maxItems": 75, "minItems": 75},
          "phase": {"const": "whole_system_classification"},
          "source_candidate_count": {"const": 75}
        }}
      }}
    },
    {
      "if": {"properties": {"scope": {"properties": {"gate": {"const": "gate_2_pending"}}}}},
      "then": {"properties": {"guarantees": {"items": {"properties": {
        "activation_status": {"const": "unactivated"}
      }}}}}
    }
  ],
  "properties": {
    "audit_baseline_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "guarantees": {"items": {"$ref": "#/$defs/guarantee"}, "minItems": 1, "type": "array"},
    "schema_version": {"const": "qt.guarantee_registry.v1"},
    "scope": {"$ref": "#/$defs/scope"}
  },
  "required": ["schema_version", "audit_baseline_commit", "scope", "guarantees"],
  "title": "QT Guarantee Registry v1",
  "type": "object",
  "$defs": {
    "activationAttestationRef": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {"pattern": "^QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+$", "type": "string"},
        "path": {"pattern": "^docs/assurance/guarantees/attestations/[0-9a-f]{40}/QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+\\.json$", "type": "string"},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "required": ["attestation_id", "path", "sha256"],
      "type": "object"
    },
    "activationDecisionRef": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {"pattern": "^QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+$", "type": "string"},
        "attestation_sha256": {"$ref": "#/$defs/hash"},
        "decision_id": {"pattern": "^QT-ACT-DEC-[0-9]{3}$", "type": "string"},
        "decision_type": {"const": "guarantee_activation"},
        "external_review_ref": {"$ref": "#/$defs/externalReviewRef"},
        "gate_id": {"const": "activation_review"},
        "locator": {"$ref": "#/$defs/locator"},
        "outcome": {"const": "approved"},
        "path": {"pattern": "^docs/assurance/guarantees/activation-decisions/.+\\.md$", "type": "string"},
        "reviewed_at": {"pattern": "Z$", "type": "string"},
        "reviewed_by": {"minLength": 1, "type": "string"},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "required": [
        "decision_id", "decision_type", "gate_id", "outcome", "attestation_id", "attestation_sha256", "reviewed_by", "reviewed_at",
        "external_review_ref", "path", "locator", "sha256"
      ],
      "type": "object"
    },
    "authorityRef": {
      "additionalProperties": false,
      "properties": {
        "authority_kind": {"enum": [
          "normative_platform_contract",
          "source_module_contract",
          "normative_agent_governance",
          "operational_canonical",
          "decision_record",
          "explanatory_architecture",
          "operational_guidance",
          "historical_evidence"
        ]},
        "locator": {"$ref": "#/$defs/locator"},
        "path": {"$ref": "#/$defs/repoPath"},
        "role": {"enum": ["primary", "supporting", "conflicting", "context"]},
        "source_lifecycle": {"enum": ["active", "accepted", "proposed", "draft", "superseded", "historical", "unclear"]}
      },
      "required": ["path", "locator", "authority_kind", "source_lifecycle", "role"],
      "type": "object"
    },
    "candidateRef": {
      "additionalProperties": false,
      "properties": {
        "id": {"pattern": "^QT-GC-[0-9]{3}$", "type": "string"},
        "relation": {"enum": ["equivalent", "split_part", "merged_source"]}
      },
      "required": ["id", "relation"],
      "type": "object"
    },
    "enforcementRef": {
      "additionalProperties": false,
      "properties": {
        "coverage": {"enum": ["complete", "partial", "supporting"]},
        "id": {"pattern": "^QT-ENF-[0-9]{3}$", "type": "string"},
        "kind": {"enum": ["runtime_guard", "schema_validation", "database_constraint", "workflow_gate", "process_control", "structural_boundary"]},
        "locator": {"$ref": "#/$defs/locator"},
        "path": {"$ref": "#/$defs/repoPath"}
      },
      "required": ["id", "kind", "path", "locator", "coverage"],
      "type": "object"
    },
    "guarantee": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"activation_status": {"const": "unactivated"}}},
          "then": {"properties": {
            "activation_attestation_refs": {"maxItems": 0},
            "activation_decision_refs": {"maxItems": 0}
          }}
        },
        {
          "if": {"properties": {"activation_status": {"const": "active"}}},
          "then": {"properties": {
            "activation_attestation_refs": {"minItems": 1},
            "activation_decision_refs": {"minItems": 1},
            "registry_disposition": {"const": "enforced"}
          }}
        },
        {
          "if": {"properties": {"wording_constraints": {"maxItems": 0}}},
          "then": {"properties": {
            "authority_refs": {"minItems": 2},
            "conformance": {"const": "contradicted"},
            "finding_refs": {"minItems": 1},
            "registry_disposition": {"const": "contradicted"}
          }}
        },
        {
          "if": {"properties": {"registry_disposition": {"const": "enforced"}}},
          "then": {"properties": {
            "authority_refs": {"allOf": [
              {"contains": {"properties": {
                "authority_kind": {"const": "normative_platform_contract"},
                "role": {"const": "primary"},
                "source_lifecycle": {"const": "active"}
              }, "required": ["authority_kind", "role", "source_lifecycle"]}},
              {"not": {"contains": {"properties": {"role": {"const": "conflicting"}}, "required": ["role"]}}}
            ]},
            "claim_lifecycle": {"const": "current"},
            "conformance": {"const": "static_aligned"},
            "enforcement_maturity": {"enum": ["adequate", "defense_in_depth"]},
            "enforcement_refs": {"contains": {"properties": {"coverage": {"const": "complete"}}, "required": ["coverage"]}},
            "proof_maturity": {"const": "adequate"},
            "proof_mode": {"enum": ["automated", "manual", "mixed"]},
            "remediation_status": {"enum": ["not_required", "resolved"]}
          }}
        },
        {
          "if": {"properties": {"registry_disposition": {"const": "partially_enforced"}}},
          "then": {
            "anyOf": [
              {"not": {"properties": {"conformance": {"const": "static_aligned"}}}},
              {"not": {"properties": {"enforcement_maturity": {"enum": ["adequate", "defense_in_depth"]}}}},
              {"properties": {"enforcement_refs": {"not": {"contains": {"properties": {"coverage": {"const": "complete"}}, "required": ["coverage"]}}}}},
              {"not": {"properties": {"proof_maturity": {"const": "adequate"}}}}
            ],
            "properties": {
              "authority_refs": {"allOf": [
                {"contains": {"properties": {
                  "role": {"const": "primary"},
                  "source_lifecycle": {"enum": ["active", "accepted"]}
                }, "required": ["role", "source_lifecycle"]}},
                {"not": {"contains": {"properties": {"role": {"const": "conflicting"}}, "required": ["role"]}}}
              ]},
              "claim_lifecycle": {"const": "current"},
              "enforcement_refs": {"minItems": 1},
              "proof_maturity": {"enum": ["named", "partial", "adequate"]}
            }
          }
        }
      ],
      "properties": {
        "activation_attestation_refs": {"items": {"$ref": "#/$defs/activationAttestationRef"}, "type": "array", "uniqueItems": true},
        "activation_decision_refs": {"items": {"$ref": "#/$defs/activationDecisionRef"}, "type": "array", "uniqueItems": true},
        "activation_status": {"enum": ["unactivated", "active"]},
        "authority_refs": {"items": {"$ref": "#/$defs/authorityRef"}, "minItems": 1, "type": "array"},
        "candidate_refs": {"items": {"$ref": "#/$defs/candidateRef"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "claim_kind": {"enum": ["behavioral_invariant", "safety_invariant", "authority_boundary", "capability_ceiling", "operational_policy", "governance_policy", "documentation_invariant"]},
        "claim_lifecycle": {"enum": ["current", "proposed", "superseded", "historical", "unclear"]},
        "claim_scope": {"items": {"$ref": "#/$defs/indexedSummary"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "claim_summary": {"$ref": "#/$defs/indexedSummary"},
        "conformance": {"enum": ["static_aligned", "partial", "contradicted", "unclear", "not_assessed"]},
        "enforcement_maturity": {"enum": ["none", "named", "partial", "adequate", "defense_in_depth", "unclear"]},
        "enforcement_refs": {"items": {"$ref": "#/$defs/enforcementRef"}, "type": "array"},
        "failure_semantics": {"items": {"$ref": "#/$defs/indexedSummary"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "finding_refs": {"items": {"pattern": "^(?:QT-CONFLICT-[0-9]{3}|[A-Z][A-Z0-9-]+-[0-9]{3})$", "type": "string"}, "type": "array", "uniqueItems": true},
        "id": {"pattern": "^QT-GUAR-[A-Z0-9]+(?:-[A-Z0-9]+)*$", "type": "string"},
        "owners": {"items": {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "proof_maturity": {"enum": ["none", "named", "partial", "adequate", "unclear"]},
        "proof_mode": {"enum": ["none", "automated", "manual", "mixed"]},
        "registry_disposition": {"enum": ["enforced", "partially_enforced", "candidate", "implementation_property", "superseded", "contradicted", "unclear"]},
        "remediation_refs": {"items": {"$ref": "#/$defs/remediationRef"}, "type": "array", "uniqueItems": true},
        "remediation_status": {"enum": ["not_required", "pending", "recorded", "resolved"]},
        "replaced_by_ids": {"items": {"pattern": "^QT-GUAR-[A-Z0-9]+(?:-[A-Z0-9]+)*$", "type": "string"}, "type": "array", "uniqueItems": true},
        "term_refs": {"items": {"pattern": "^QT-TERM-[0-9]{3}$", "type": "string"}, "type": "array", "uniqueItems": true},
        "title": {"minLength": 1, "type": "string"},
        "wording_constraints": {"items": {"$ref": "#/$defs/indexedSummary"}, "type": "array", "uniqueItems": true}
      },
      "required": [
        "id", "candidate_refs", "title", "claim_summary", "claim_scope",
        "failure_semantics", "wording_constraints", "owners", "claim_kind",
        "claim_lifecycle", "registry_disposition", "activation_status",
        "activation_decision_refs", "activation_attestation_refs", "conformance",
        "enforcement_maturity", "proof_maturity", "proof_mode", "term_refs",
        "authority_refs", "enforcement_refs", "finding_refs", "remediation_status", "remediation_refs",
        "replaced_by_ids"
      ],
      "type": "object"
    },
    "externalReviewRef": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {"minLength": 1, "type": "string"},
        "sha256": {"$ref": "#/$defs/hash"},
        "system": {"pattern": "^[a-z][a-z0-9-]*$", "type": "string"}
      },
      "required": ["system", "reference_id", "sha256"],
      "type": "object"
    },
    "hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "heading": {
      "additionalProperties": false,
      "properties": {"kind": {"const": "heading"}, "value": {"minLength": 1, "type": "string"}},
      "required": ["kind", "value"],
      "type": "object"
    },
    "indexedSummary": {
      "pattern": "^(?!.*\\b(?:MUST(?: NOT)?|SHALL(?: NOT)?|REQUIRED)\\b)\\S(?:.*\\S)?$",
      "type": "string"
    },
    "lineRange": {
      "additionalProperties": false,
      "properties": {
        "end": {"minimum": 1, "type": "integer"},
        "kind": {"const": "line_range"},
        "start": {"minimum": 1, "type": "integer"}
      },
      "required": ["kind", "start", "end"],
      "type": "object"
    },
    "locator": {"oneOf": [{"$ref": "#/$defs/lineRange"}, {"$ref": "#/$defs/heading"}]},
    "repoPath": {
      "minLength": 1,
      "not": {"pattern": "(?:^/|\\\\|(?:^|/)\\.\\.(?:/|$))"},
      "type": "string"
    },
    "remediationRef": {
      "additionalProperties": false,
      "properties": {
        "id": {"pattern": "^QT-REM-[0-9]{3}$", "type": "string"},
        "lifecycle": {"enum": ["proposed", "active", "resolved", "superseded"]},
        "locator": {"$ref": "#/$defs/locator"},
        "path": {"pattern": "^docs/assurance/guarantees/remediations/QT-REM-[0-9]{3}\\.md$", "type": "string"}
      },
      "required": ["id", "path", "locator", "lifecycle"],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "gate": {"enum": ["gate_2_pending", "gate_2_approved", "complete"]},
        "included_candidate_ids": {"items": {"pattern": "^QT-GC-[0-9]{3}$", "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "phase": {"enum": ["phase_2a_calibration", "whole_system_classification"]},
        "source_candidate_count": {"minimum": 1, "type": "integer"},
        "whole_system_classification_complete": {"type": "boolean"}
      },
      "required": ["phase", "gate", "source_candidate_count", "included_candidate_ids", "whole_system_classification_complete"],
      "type": "object"
    }
  }
}
