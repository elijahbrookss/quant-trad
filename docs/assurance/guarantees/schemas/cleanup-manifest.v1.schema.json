{
  "$id": "https://quant-trad.local/schemas/assurance-cleanup-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "cleanup_manifest"
    },
    "facts": {
      "$ref": "#/$defs/facts"
    },
    "profile_id": {
      "$ref": "#/$defs/profileId"
    },
    "schema_version": {
      "const": "qt.assurance_environment_evidence.v1"
    },
    "service_id": {
      "$ref": "#/$defs/profileId"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "artifact_kind",
    "facts"
  ],
  "title": "QT Assurance Cleanup Manifest v1",
  "type": "object",
  "$defs": {
    "facts": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {
          "pattern": "^QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+$",
          "type": "string"
        },
        "cleanup_completed": {
          "const": true
        },
        "cleanup_finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "cleanup_started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "control_plane_identity_sha256": {
          "$ref": "#/$defs/hash"
        },
        "environment_instance_id": {
          "pattern": "^[a-z][a-z0-9-]{7,127}$",
          "type": "string"
        },
        "execution_draft_sha256": {
          "$ref": "#/$defs/hash"
        },
        "execution_manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "exit_code": {
          "const": 0
        },
        "label_query_remaining": {
          "maxItems": 0,
          "type": "array"
        },
        "record_schema_version": {
          "const": "qt.assurance_cleanup_manifest.v1"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/resourceDisposition"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/hash"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "record_schema_version",
        "attestation_id",
        "source_commit",
        "execution_draft_sha256",
        "execution_manifest_sha256",
        "environment_instance_id",
        "control_plane_identity_sha256",
        "cleanup_started_at",
        "cleanup_finished_at",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "cleanup_completed",
        "resources",
        "label_query_remaining"
      ],
      "type": "object"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profileId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "resourceDisposition": {
      "additionalProperties": false,
      "properties": {
        "absent": {
          "const": true
        },
        "kind": {
          "enum": [
            "container",
            "database",
            "network",
            "published_endpoint",
            "temporary_secret_file",
            "volume"
          ]
        },
        "logical_name": {
          "minLength": 1,
          "type": "string"
        },
        "runtime_identity": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "logical_name",
        "runtime_identity",
        "absent"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  }
}
