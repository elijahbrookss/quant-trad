{
  "$id": "https://quant-trad.local/schemas/assurance-runner-build-record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "output_image": {
            "$ref": "#/$defs/outputImage"
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "not": {
              "const": 0
            }
          },
          "output_image": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "base_images": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/nodeBaseImage"
        },
        {
          "$ref": "#/$defs/pythonBaseImage"
        }
      ],
      "type": "array",
      "uniqueItems": true
    },
    "build_context": {
      "$ref": "#/$defs/buildContext"
    },
    "build_id": {
      "pattern": "^QT-RUNNER-BUILD-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$",
      "type": "string"
    },
    "docker_tool": {
      "$ref": "#/$defs/dockerTool"
    },
    "exit_code": {
      "maximum": 255,
      "minimum": -255,
      "type": "integer"
    },
    "external_order_submission_enabled": {
      "const": false
    },
    "finished_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "invocation": {
      "$ref": "#/$defs/invocation"
    },
    "log": {
      "$ref": "#/$defs/logFile"
    },
    "output_image": {
      "oneOf": [
        {
          "$ref": "#/$defs/outputImage"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "qt.assurance_runner_build_record.v1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "source_materials": {
      "$ref": "#/$defs/sourceMaterials"
    },
    "started_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "wheel_artifacts": {
      "$ref": "#/$defs/wheelArtifacts"
    }
  },
  "required": [
    "schema_version",
    "build_id",
    "status",
    "source",
    "source_materials",
    "wheel_artifacts",
    "build_context",
    "docker_tool",
    "base_images",
    "invocation",
    "started_at",
    "finished_at",
    "exit_code",
    "log",
    "output_image",
    "external_order_submission_enabled"
  ],
  "title": "QT Assurance Runner Build Record v1",
  "type": "object",
  "$defs": {
    "aggregate": {
      "additionalProperties": false,
      "properties": {
        "entry_count": {
          "minimum": 1,
          "type": "integer"
        },
        "entry_manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "selected_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "entry_count",
        "selected_bytes",
        "entry_manifest_sha256"
      ],
      "type": "object"
    },
    "baseImage": {
      "additionalProperties": false,
      "properties": {
        "argument": {
          "enum": [
            "NODE_IMAGE",
            "PYTHON_IMAGE"
          ]
        },
        "digest": {
          "$ref": "#/$defs/imageDigest"
        },
        "image_id": {
          "$ref": "#/$defs/imageDigest"
        },
        "platform": {
          "const": "linux/amd64"
        },
        "reference": {
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "stage": {
          "enum": [
            "node_runtime",
            "runtime"
          ]
        }
      },
      "required": [
        "argument",
        "stage",
        "reference",
        "digest",
        "image_id",
        "platform"
      ],
      "type": "object"
    },
    "nodeBaseImage": {
      "allOf": [
        {
          "$ref": "#/$defs/baseImage"
        },
        {
          "properties": {
            "argument": {
              "const": "NODE_IMAGE"
            },
            "digest": {
              "const": "sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0"
            },
            "reference": {
              "const": "docker.io/library/node@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0"
            },
            "stage": {
              "const": "node_runtime"
            }
          }
        }
      ]
    },
    "pythonBaseImage": {
      "allOf": [
        {
          "$ref": "#/$defs/baseImage"
        },
        {
          "properties": {
            "argument": {
              "const": "PYTHON_IMAGE"
            },
            "digest": {
              "const": "sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134"
            },
            "reference": {
              "const": "docker.io/library/python@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134"
            },
            "stage": {
              "const": "runtime"
            }
          }
        }
      ]
    },
    "buildContext": {
      "additionalProperties": false,
      "properties": {
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "tar": {
          "allOf": [
            {
              "$ref": "#/$defs/basenameFile"
            },
            {
              "properties": {
                "basename": {
                  "const": "build-context.tar"
                }
              }
            }
          ]
        }
      },
      "required": [
        "tar",
        "inventory"
      ],
      "type": "object"
    },
    "basenameFile": {
      "additionalProperties": false,
      "properties": {
        "basename": {
          "pattern": "^[^/\\\\]+$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "basename",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "dockerTool": {
      "additionalProperties": false,
      "properties": {
        "daemon_identity_sha256": {
          "$ref": "#/$defs/hash"
        },
        "executable_basename": {
          "pattern": "^[^/\\\\]+$",
          "type": "string"
        },
        "executable_sha256": {
          "$ref": "#/$defs/hash"
        },
        "resolved_path_sha256": {
          "$ref": "#/$defs/hash"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "executable_basename",
        "executable_sha256",
        "resolved_path_sha256",
        "version",
        "daemon_identity_sha256"
      ],
      "type": "object"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "imageDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "imageLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "com.quant-trad.assurance.build-context-sha256": {
          "$ref": "#/$defs/hash"
        },
        "com.quant-trad.assurance.build-definition-sha256": {
          "$ref": "#/$defs/hash"
        },
        "com.quant-trad.assurance.build-profile-sha256": {
          "$ref": "#/$defs/hash"
        },
        "com.quant-trad.assurance.source": {
          "$ref": "#/$defs/commit"
        },
        "com.quant-trad.assurance.source-tree": {
          "$ref": "#/$defs/commit"
        },
        "com.quant-trad.assurance.wheel-artifact-sha256": {
          "$ref": "#/$defs/hash"
        },
        "com.quant-trad.assurance.wheel-manifest-sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "com.quant-trad.assurance.source",
        "com.quant-trad.assurance.source-tree",
        "com.quant-trad.assurance.build-profile-sha256",
        "com.quant-trad.assurance.build-definition-sha256",
        "com.quant-trad.assurance.wheel-manifest-sha256",
        "com.quant-trad.assurance.wheel-artifact-sha256",
        "com.quant-trad.assurance.build-context-sha256"
      ],
      "type": "object"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/inventoryEntry"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inventoryEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "invocation": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "minLength": 1,
            "not": {
              "pattern": "[\\u0000\\r\\n]"
            },
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "argv_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context_stdin_sha256": {
          "$ref": "#/$defs/hash"
        },
        "output_tag": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+:-]{0,255}$",
          "type": "string"
        },
        "timeout_seconds": {
          "const": 7200
        }
      },
      "required": [
        "argv",
        "argv_sha256",
        "context_stdin_sha256",
        "output_tag",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "logFile": {
      "allOf": [
        {
          "$ref": "#/$defs/basenameFile"
        },
        {
          "properties": {
            "basename": {
              "const": "runner-build.log"
            }
          }
        }
      ]
    },
    "outputImage": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "$ref": "#/$defs/imageDigest"
        },
        "labels": {
          "$ref": "#/$defs/imageLabels"
        },
        "platform": {
          "const": "linux/amd64"
        }
      },
      "required": [
        "image_id",
        "platform",
        "labels"
      ],
      "type": "object"
    },
    "repoPath": {
      "minLength": 1,
      "not": {
        "pattern": "(?:^/|\\\\|(?:^|/)\\.\\.(?:/|$))"
      },
      "type": "string"
    },
    "requiresPython": {
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "sourceMaterial": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "sourceMaterials": {
      "additionalProperties": false,
      "properties": {
        "build_profile": {
          "$ref": "#/$defs/sourceMaterial"
        },
        "dockerfile": {
          "$ref": "#/$defs/sourceMaterial"
        },
        "materializer": {
          "$ref": "#/$defs/sourceMaterial"
        },
        "requirements_lock": {
          "$ref": "#/$defs/sourceMaterial"
        },
        "wheel_manifest": {
          "$ref": "#/$defs/sourceMaterial"
        }
      },
      "required": [
        "build_profile",
        "dockerfile",
        "requirements_lock",
        "wheel_manifest",
        "materializer"
      ],
      "type": "object"
    },
    "wheelArtifacts": {
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/wheelEntry"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "tar": {
          "allOf": [
            {
              "$ref": "#/$defs/basenameFile"
            },
            {
              "properties": {
                "basename": {
                  "const": "wheelhouse.tar"
                }
              }
            }
          ]
        }
      },
      "required": [
        "entries",
        "aggregate",
        "tar"
      ],
      "type": "object"
    },
    "wheelEntry": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "pattern": "^[^/\\\\]+\\.whl$",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "requires_python": {
          "$ref": "#/$defs/requiresPython"
        },
        "selected_tag": {
          "$ref": "#/$defs/wheelTag"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "size": {
          "minimum": 1,
          "type": "integer"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "wheel_tags": {
          "items": {
            "$ref": "#/$defs/wheelTag"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "version",
        "filename",
        "sha256",
        "size",
        "selected_tag",
        "wheel_tags",
        "requires_python"
      ],
      "type": "object"
    },
    "wheelTag": {
      "pattern": "^[A-Za-z0-9_.]+-[A-Za-z0-9_.]+-[A-Za-z0-9_.]+$",
      "type": "string"
    }
  }
}
