{
  "$id": "https://quant-trad.local/schemas/assurance-execution-draft.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "execution_draft"
    },
    "facts": {
      "$ref": "#/$defs/facts"
    },
    "profile_id": {
      "$ref": "#/$defs/profileId"
    },
    "schema_version": {
      "const": "qt.assurance_environment_evidence.v1"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "artifact_kind",
    "facts"
  ],
  "title": "QT Assurance Execution Draft v1",
  "type": "object",
  "$defs": {
    "attestationId": {
      "pattern": "^QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+$",
      "type": "string"
    },
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "facts": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "pattern": "^[a-z][a-z0-9-]{2,127}$",
          "type": "string"
        },
        "attestation_id": {
          "$ref": "#/$defs/attestationId"
        },
        "control_plane_identity_sha256": {
          "$ref": "#/$defs/hash"
        },
        "environment_instance_id": {
          "pattern": "^[a-z][a-z0-9-]{7,127}$",
          "type": "string"
        },
        "execution_admission_sha256": {
          "$ref": "#/$defs/hash"
        },
        "execution_admission_archive_sha256": {
          "$ref": "#/$defs/hash"
        },
        "external_order_submission_enabled": {
          "const": false
        },
        "planned_resources": {
          "items": {
            "$ref": "#/$defs/plannedResource"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "record_schema_version": {
          "const": "qt.assurance_execution_draft.v1"
        },
        "requested_profile_ids": {
          "items": {
            "$ref": "#/$defs/profileId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "runtime_definition_sha256": {
          "$ref": "#/$defs/hash"
        },
        "runner_build_record_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/hash"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "record_schema_version",
        "attestation_id",
        "source_commit",
        "source_snapshot_sha256",
        "requested_profile_ids",
        "started_at",
        "admission_id",
        "environment_instance_id",
        "control_plane_identity_sha256",
        "runtime_definition_sha256",
        "execution_admission_sha256",
        "execution_admission_archive_sha256",
        "runner_build_record_sha256",
        "external_order_submission_enabled",
        "planned_resources"
      ],
      "type": "object"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "plannedResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "container",
            "database",
            "network",
            "published_endpoint",
            "source_snapshot",
            "temporary_secret_file",
            "volume"
          ]
        },
        "logical_name": {
          "minLength": 1,
          "pattern": "^[^\\u0000\\r\\n]+$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "logical_name"
      ],
      "type": "object"
    },
    "profileId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  }
}
