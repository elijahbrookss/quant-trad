{
  "$id": "https://quant-trad.local/schemas/assurance-cleanup-recovery-intent.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_id": {
      "pattern": "^[a-z][a-z0-9-]{2,127}$",
      "type": "string"
    },
    "attestation_emitted": {
      "const": false
    },
    "attestation_id": {
      "$ref": "#/$defs/attestationId"
    },
    "control_plane_identity_sha256": {
      "$ref": "#/$defs/hash"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "environment_instance_id": {
      "pattern": "^[a-z][a-z0-9-]{7,127}$",
      "type": "string"
    },
    "execution_admission_archive_sha256": {
      "$ref": "#/$defs/hash"
    },
    "execution_admission_sha256": {
      "$ref": "#/$defs/hash"
    },
    "execution_draft": {
      "$ref": "#/$defs/artifactRef"
    },
    "finalizable": {
      "const": false
    },
    "planned_resources": {
      "items": {
        "$ref": "#/$defs/plannedResource"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "profile_id": {
      "$ref": "#/$defs/profileId"
    },
    "recovery_attempt_id": {
      "$ref": "#/$defs/recoveryAttemptId"
    },
    "recovery_state": {
      "const": "cleanup_pending"
    },
    "report_file_name": {
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "qt.assurance_cleanup_recovery_intent.v1"
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "source_snapshot_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "required": [
    "schema_version",
    "recovery_attempt_id",
    "created_at",
    "source_commit",
    "attestation_id",
    "profile_id",
    "admission_id",
    "environment_instance_id",
    "control_plane_identity_sha256",
    "source_snapshot_sha256",
    "execution_admission_sha256",
    "execution_admission_archive_sha256",
    "execution_draft",
    "planned_resources",
    "report_file_name",
    "recovery_state",
    "finalizable",
    "attestation_emitted"
  ],
  "title": "QT Assurance Cleanup Recovery Intent v1",
  "type": "object",
  "$defs": {
    "artifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^docs/assurance/guarantees/evidence/QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+/_environments/[a-z][a-z0-9-]*/execution_draft-001-profile\\.json$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "attestationId": {
      "pattern": "^QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+$",
      "type": "string"
    },
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "plannedResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "container",
            "database",
            "network",
            "published_endpoint",
            "source_snapshot",
            "temporary_secret_file",
            "volume"
          ]
        },
        "logical_name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "logical_name"
      ],
      "type": "object"
    },
    "profileId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "recoveryAttemptId": {
      "pattern": "^QT-REC-[0-9a-f]{24}$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  }
}
