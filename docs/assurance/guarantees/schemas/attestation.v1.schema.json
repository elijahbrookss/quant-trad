{
  "$id": "https://quant-trad.local/schemas/guarantee-attestation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation_id": {
      "pattern": "^QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+$",
      "type": "string"
    },
    "environments": {
      "items": {
        "$ref": "#/$defs/environment"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "guarantee_results": {
      "items": {
        "$ref": "#/$defs/guaranteeResult"
      },
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "proof_results": {
      "items": {
        "$ref": "#/$defs/proofResult"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "qt.guarantee_attestation.v1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "required": [
    "schema_version",
    "attestation_id",
    "source",
    "inputs",
    "environments",
    "started_at",
    "finished_at",
    "proof_results",
    "guarantee_results"
  ],
  "title": "QT Guarantee Attestation v1",
  "type": "object",
  "$defs": {
    "environment": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "minLength": 1,
          "type": "string"
        },
        "lockfile_hashes": {
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          },
          "type": "object"
        },
        "os": {
          "minLength": 1,
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "profile_admission": {
          "$ref": "#/$defs/profileAdmission"
        },
        "services": {
          "additionalProperties": {
            "$ref": "#/$defs/serviceAdmission"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": "object"
        },
        "tool_versions": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "profile_id",
        "os",
        "architecture",
        "tool_versions",
        "lockfile_hashes",
        "profile_admission",
        "services"
      ],
      "type": "object"
    },
    "admissionFacts": {
      "additionalProperties": {
        "$ref": "#/$defs/factValue"
      },
      "minProperties": 1,
      "type": "object"
    },
    "environmentEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "enum": [
            "base_image_digests",
            "bootstrap_log",
            "cleanup_manifest",
            "cleanup_log",
            "container_identity",
            "database_identity",
            "execution_draft",
            "execution_manifest",
            "extension_versions",
            "image_digest",
            "network_mode",
            "published_endpoint",
            "recovery_manifest",
            "runtime_probe",
            "server_version",
            "source_mount"
          ]
        },
        "path": {
          "pattern": "^docs/assurance/guarantees/evidence/QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+/_environments/[a-z][a-z0-9-]*/[^/]+$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "artifact_kind",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "evidenceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "enum": ["stdout", "stderr", "result_summary", "manual_evidence"]
        },
        "path": {
          "pattern": "^docs/assurance/guarantees/evidence/QT-ATT-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8,40}-[a-z0-9-]+/QT-PROOF-[0-9]{3}/[^/]+$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "artifact_kind",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "factValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/factValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/factValue"
          },
          "type": "object"
        }
      ]
    },
    "guaranteeResult": {
      "additionalProperties": false,
      "properties": {
        "guarantee_id": {
          "pattern": "^QT-GUAR-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
          "type": "string"
        },
        "proof_ids": {
          "items": {
            "pattern": "^QT-PROOF-[0-9]{3}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/resultStatus"
        }
      },
      "required": [
        "guarantee_id",
        "status",
        "proof_ids"
      ],
      "type": "object"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "glossaryInput": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "docs/plans/documentation-reconciliation/proposed-glossary.md",
            "docs/contracts/platform/04_glossary.md"
          ]
        },
        "sha256": {"$ref": "#/$defs/hash"},
        "source_kind": {"enum": ["proposal", "adopted_normative"]}
      },
      "required": ["source_kind", "path", "sha256"],
      "type": "object"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "glossary_inputs": {
          "items": {"$ref": "#/$defs/glossaryInput"},
          "type": "array",
          "uniqueItems": true
        },
        "guarantee_material_sha256": {
          "additionalProperties": false,
          "patternProperties": {
            "^QT-GUAR-[A-Z0-9]+(?:-[A-Z0-9]+)*$": {"$ref": "#/$defs/hash"}
          },
          "type": "object"
        },
        "proof_catalog_sha256": {
          "$ref": "#/$defs/hash"
        },
        "required_proof_material_sha256": {
          "additionalProperties": false,
          "patternProperties": {
            "^QT-PROOF-[0-9]{3}$": {"$ref": "#/$defs/hash"}
          },
          "type": "object"
        },
        "registry_semantics_sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "registry_semantics_sha256",
        "proof_catalog_sha256",
        "guarantee_material_sha256",
        "required_proof_material_sha256",
        "glossary_inputs"
      ],
      "type": "object"
    },
    "profileAdmission": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "pattern": "^[a-z][a-z0-9-]{2,127}$",
          "type": "string"
        },
        "environment_class": {
          "enum": ["ephemeral_ci", "isolated_test"]
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/environmentEvidenceRef"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "external_order_submission_enabled": {
          "const": false
        },
        "facts": {
          "$ref": "#/$defs/admissionFacts"
        },
        "isolation": {
          "enum": ["disposable", "session_scoped"]
        },
        "runtime_definition": {
          "$ref": "#/$defs/runtimeDefinition"
        }
      },
      "required": [
        "admission_id",
        "environment_class",
        "isolation",
        "external_order_submission_enabled",
        "runtime_definition",
        "facts",
        "evidence_refs"
      ],
      "type": "object"
    },
    "proofResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "started_at",
                "finished_at"
              ]
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "started_at"
                    ]
                  },
                  {
                    "required": [
                      "finished_at"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "evidence_refs": {"minItems": 1}
                },
                "required": [
                  "executed_argv"
                ]
              },
              {
                "properties": {
                  "evidence_refs": {
                    "minItems": 1
                  }
                },
                "required": [
                  "operator_identity",
                  "reviewer_identity"
                ]
              }
            ],
            "required": [
              "started_at",
              "finished_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PARTIAL"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {"const": 0}
            },
            "required": [
              "executed_argv"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_RUN",
                  "MANUAL",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "executed_argv"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAIL"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_RUN",
                  "MANUAL",
                  "PARTIAL",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_RUN",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["started_at"] },
                { "required": ["finished_at"] },
                { "required": ["exit_code"] },
                { "required": ["collected_count"] },
                { "required": ["passed_count"] },
                { "required": ["failed_count"] },
                { "required": ["skipped_count"] },
                { "required": ["xfailed_count"] },
                { "required": ["xpassed_count"] },
                { "required": ["node_test_result"] },
                { "required": ["stdout_sha256"] },
                { "required": ["stderr_sha256"] },
                { "required": ["result_summary_sha256"] },
                { "required": ["executed_argv"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "MANUAL"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "started_at",
              "finished_at",
              "operator_identity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PARTIAL"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "evidence_refs": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "stdout_sha256"
                ]
              },
              {
                "required": [
                  "stderr_sha256"
                ]
              }
            ],
            "required": [
              "started_at",
              "finished_at"
            ]
          }
        }
      ],
      "properties": {
        "collected_count": {
          "minimum": 0,
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "type": "array",
          "uniqueItems": true
        },
        "executed_argv": {
          "items": {
            "minLength": 1,
            "pattern": "^[^\\u0000\\r\\n]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "failed_count": {
          "minimum": 0,
          "type": "integer"
        },
        "node_test_result": {
          "$ref": "#/$defs/nodeTestResult"
        },
        "environment_profile_id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "exit_code": {
          "minimum": 0,
          "type": "integer"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "operator_identity": {
          "minLength": 1,
          "type": "string"
        },
        "passed_count": {
          "minimum": 0,
          "type": "integer"
        },
        "proof_id": {
          "pattern": "^QT-PROOF-[0-9]{3}$",
          "type": "string"
        },
        "reason_code": {
          "minLength": 1,
          "type": "string"
        },
        "reviewer_identity": {
          "minLength": 1,
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "skipped_count": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/resultStatus",
          "description": "Cross-file executable validation permits automated PASS only for admitted pytest or native node_test proof-catalog runners in v1; manual PASS follows the reviewed-manual branch."
        },
        "stderr_sha256": {
          "$ref": "#/$defs/hash"
        },
        "result_summary_sha256": {
          "$ref": "#/$defs/hash"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/hash"
        },
        "xfailed_count": {
          "minimum": 0,
          "type": "integer"
        },
        "xpassed_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "proof_id",
        "environment_profile_id",
        "status",
        "evidence_refs"
      ],
      "type": "object"
    },
    "nodeTestResult": {
      "additionalProperties": false,
      "properties": {
        "cancelled_count": {
          "minimum": 0,
          "type": "integer"
        },
        "collected_files": {
          "items": {
            "$ref": "#/$defs/repoPath"
          },
          "type": "array",
          "uniqueItems": true
        },
        "excluded_nonmatch_test_names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "explicitly_skipped_count": {
          "minimum": 0,
          "type": "integer"
        },
        "reporter_path": {
          "$ref": "#/$defs/repoPath"
        },
        "schema_version": {
          "const": "qt.node_test_result.v1"
        },
        "selected_test_names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "todo_count": {
          "minimum": 0,
          "type": "integer"
        },
        "transport_schema_version": {
          "const": "qt.node_test_events.v1"
        }
      },
      "required": [
        "schema_version",
        "transport_schema_version",
        "reporter_path",
        "collected_files",
        "selected_test_names",
        "excluded_nonmatch_test_names",
        "explicitly_skipped_count",
        "cancelled_count",
        "todo_count"
      ],
      "type": "object"
    },
    "repoPath": {
      "minLength": 1,
      "not": {
        "pattern": "(?:^/|\\\\|(?:^|/)\\.\\.(?:/|$))"
      },
      "type": "string"
    },
    "runtimeDefinition": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": ["path", "sha256"],
      "type": "object"
    },
    "serviceAdmission": {
      "additionalProperties": false,
      "properties": {
        "environment_class": {
          "enum": ["ephemeral_ci", "isolated_test"]
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/environmentEvidenceRef"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "external_order_submission_enabled": {
          "const": false
        },
        "facts": {
          "$ref": "#/$defs/admissionFacts"
        },
        "isolation": {
          "enum": ["disposable", "session_scoped"]
        }
      },
      "required": [
        "environment_class",
        "isolation",
        "external_order_submission_enabled",
        "facts",
        "evidence_refs"
      ],
      "type": "object"
    },
    "resultStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "MANUAL",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "assurance_material_sha256": {
          "$ref": "#/$defs/hash"
        },
        "clean": {
          "type": "boolean"
        },
        "git_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "git_commit",
        "clean",
        "assurance_material_sha256"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    }
  }
}
