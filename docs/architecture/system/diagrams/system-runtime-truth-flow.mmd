flowchart LR
    provider["Explicit provider acquisition"]
    facts["Canonical Facts<br/>source + revisions + known-at + gaps"]
    dataset["Frozen Dataset<br/>ranges + per-series commit scope"]
    binding["Frozen read binding<br/>verified material"]
    check["Registered Check<br/>shared Indicator engine when required"]
    memory["Research memory<br/>Observations + Studies"]
    authority["Scientific authority<br/>protocol + holdout + governance"]
    runtime["Admitted backtest<br/>Indicators -> decisions -> simulated execution"]
    ledger["Durable runtime evidence<br/>orders + trades + wallet + events"]
    views["BotLens + reports<br/>bounded inspection / compare / export"]
    api["Backend operation contracts<br/>CLI / MCP / admitted UI controls"]

    provider --> facts --> dataset --> binding
    binding --> check --> memory
    binding --> runtime --> ledger --> views
    memory --> authority
    api -. explicit requests .-> provider
    api -. admitted operations .-> check
    api -. admitted run requests .-> runtime
