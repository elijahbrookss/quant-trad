flowchart TD
    request["Explicit acquisition request<br/>audited CLI/API"]
    registry["Provider registry + reviewed manifest"]
    adapter["Acquisition adapter<br/>external I/O and normalization"]
    provider["External provider"]
    store["Canonical Facts<br/>schema + provenance + quality + revisions"]
    dataset["Frozen Dataset<br/>ranges + per-series committed watermark"]
    binding["Frozen read binding<br/>verified payloads + required archives"]
    research["Durable Check / backtest admission"]
    reads["Causal current-store reads<br/>preview / operational inspection"]
    request --> registry --> adapter
    adapter <--> provider
    adapter --> store
    store --> dataset --> binding --> research
    store --> reads
