flowchart TD
    request["Audited CLI / API<br/>explicit acquisition request"]
    registry["Provider registry<br/>provider + venue capability"]
    adapter["Acquisition-only adapter<br/>external anti-corruption"]
    credentials["Credential references"]
    api["External provider API"]
    normalize["Feed intake<br/>validate closure + known-at"]
    stream["Paper closed-candle stream"]
    store["Canonical market store<br/>append-only revisions + gaps"]
    feed["Provider-free causal feed<br/>window + commit watermark"]
    dataset["Frozen dataset manifest<br/>material + provenance + quality"]
    consumers["Research / indicators /<br/>backtest / paper / reports"]

    request --> registry
    registry --> adapter
    credentials --> adapter
    adapter <--> api
    adapter --> normalize
    stream --> normalize
    normalize --> store
    store --> feed
    store --> dataset
    feed --> consumers
    dataset --> consumers

    classDef boundary fill:#13251d,stroke:#34d399,color:#dcfce7
    classDef truth fill:#0f172a,stroke:#38bdf8,color:#e0f2fe
    classDef external fill:#1f2937,stroke:#94a3b8,color:#f8fafc
    class request,registry,adapter,credentials,normalize,feed boundary
    class stream,store,dataset,consumers truth
    class api external
