# Optional local Vite overrides.
# Docker compose already injects the normal frontend values, and the app has
# localhost defaults when run with `npm run dev` from this directory.

# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_API_PROXY_TARGET=http://localhost:8000
# VITE_LOG_LEVEL=debug
# VITE_BOTLENS_DEBUG=true
