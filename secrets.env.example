# Copy this file to `secrets.env` and fill in only the values you need.
# `secrets.env` is git-ignored and is the one operator env file used by the
# Docker stack and local CLI helpers.
#
# Provider API keys should not be stored directly in this file. Save Coinbase
# credentials into the encrypted provider credential store after the stack is up.
#
# Infrastructure rule: `PG_DSN` is the only database DSN. The Docker backend
# derives it from POSTGRES_*; host-side CLI tools may use the optional PG_DSN
# shown below.

###############################################################################
# Required local database values
###############################################################################

POSTGRES_DB=quanttrad
POSTGRES_USER=quanttrad
POSTGRES_PASSWORD=replace-with-a-local-db-password

# Host-side CLI access. Docker services override PG_DSN internally to use the
# container network host `tsdb`.
PG_DSN=postgresql+psycopg2://quanttrad:replace-with-a-local-db-password@localhost:15432/quanttrad

# Used only when the pgAdmin profile is running.
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-pgadmin-password

# Used only when the observability profile is running.
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-local-grafana-password

###############################################################################
# Required for Coinbase provider execution
###############################################################################

# Required before adding or loading encrypted provider credentials.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QT_SECURITY_PROVIDER_CREDENTIAL_KEY=replace-with-fernet-key

###############################################################################
# Coinbase credential bootstrap
###############################################################################

# After the core stack is running, store Coinbase credentials with:
#
#   qt providers credentials schema --provider COINBASE --venue COINBASE_DIRECT
#   qt providers credentials add --provider COINBASE --venue COINBASE_DIRECT
#
# For non-interactive setup, provide the API values only to that command:
#
#   LOCAL_COINBASE_KEY=... LOCAL_COINBASE_SECRET=... \
#   qt providers credentials add \
#     --provider COINBASE \
#     --venue COINBASE_DIRECT \
#     --secret-env COINBASE_API_KEY=LOCAL_COINBASE_KEY \
#     --secret-env COINBASE_API_SECRET=LOCAL_COINBASE_SECRET \
#     --no-input

###############################################################################
# Optional operator overrides
###############################################################################

# Uncomment only when the local Docker names differ from the defaults.
# QT_BOT_RUNTIME_IMAGE=quanttrad-backend:dev
# QT_BOT_RUNTIME_NETWORK=quant-trad_quanttrad

# Uncomment for local log troubleshooting.
# QT_LOGGING_LEVEL=INFO
# QT_LOGGING_DEBUG=true
# QT_LOGGING_LOKI_URL=http://loki:3100
