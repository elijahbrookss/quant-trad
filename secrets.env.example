# Prefer `scripts/automation/server_deploy.sh init-env` for a new single-node
# install. It generates `secrets.env` once with strong values and mode 0600 in
# the stable deployment root beside the Git checkout. Otherwise copy this file
# to a private path and set QT_SINGLE_NODE_ENV_FILE to it. Local development may
# continue to use the git-ignored repository-root `secrets.env` expected by the
# development Compose stack and CLI helpers.
#
# Provider API keys should not be stored directly in this file. Save Coinbase
# credentials into the encrypted provider credential store after the stack is up.
#
# Infrastructure rule: `PG_DSN` is the only database DSN. The Docker backend
# derives it from POSTGRES_*; host-side CLI tools may use the optional PG_DSN
# shown below.

###############################################################################
# Required local database values
###############################################################################

POSTGRES_DB=quanttrad
POSTGRES_USER=quanttrad
POSTGRES_PASSWORD=replace-with-a-local-db-password

# Host-side CLI access for the local development stack. The server stack
# overrides this inside backend/collector containers and uses private
# service host `tsdb`; run its operational CLI inside the backend container.
PG_DSN=postgresql+psycopg2://quanttrad:replace-with-a-local-db-password@localhost:15432/quanttrad

PGADMIN_DEFAULT_EMAIL=replace-with-your-email
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-pgadmin-password

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-local-grafana-password

###############################################################################
# Required for Coinbase provider execution
###############################################################################

# Required before adding or loading encrypted provider credentials.
# Generated by `qt setup env`.
QT_SECURITY_PROVIDER_CREDENTIAL_KEY=replace-with-fernet-key

###############################################################################
# Coinbase credential bootstrap
###############################################################################

# After the single-node stack is running, store Coinbase credentials with:
#
#   bash scripts/automation/server_deploy.sh credentials-coinbase
#
# For non-interactive setup, provide the API values only to that command:
#
#   LOCAL_COINBASE_KEY=... LOCAL_COINBASE_SECRET=... \
#   qt setup provider coinbase \
#     --secret-env COINBASE_API_KEY=LOCAL_COINBASE_KEY \
#     --secret-env COINBASE_API_SECRET=LOCAL_COINBASE_SECRET \
#     --no-input

###############################################################################
# Chainlink structured-Fact acquisition
###############################################################################

# Arbitrum One read endpoint used by reviewed Chainlink collectors. The official
# public endpoint is suitable for low-volume local reads but has no uptime,
# latency, or rate-limit guarantee; operators may replace it with a reviewed
# authenticated endpoint.
CHAINLINK_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

###############################################################################
# Optional operator overrides
###############################################################################

# Uncomment only when the local Docker names differ from the defaults.
# QT_BOT_RUNTIME_IMAGE=quanttrad-backend:dev
# QT_BOT_RUNTIME_NETWORK=quant-trad_quanttrad

# Uncomment for local log troubleshooting.
# QT_LOGGING_LEVEL=INFO
# QT_LOGGING_DEBUG=true
# QT_LOGGING_LOKI_URL=http://loki:3100

###############################################################################
# Optional portable single-node overrides
###############################################################################

# Keep this path stable. A future HDD can be mounted here without changing the
# collector or Compose configuration.
# QT_MARKET_DATA_ROOT=/srv/quanttrad/market-structure
# QT_SINGLE_NODE_STATE_ROOT=/srv/quanttrad/deploy-state
# QT_COMPOSE_PROJECT_NAME=quant-trad-single-node

# The reviewed V1 preset enrolls and starts scheduled OI/funding, continuous
# trades, and the reviewed continuous L2 fleet. These flags are install defaults
# only;
# later start/stop/pause choices remain owned by the audited lifecycle plane and
# are not overwritten on deploy.
# QT_SINGLE_NODE_BOOTSTRAP_MARKET_DATA=true
# QT_SINGLE_NODE_ENABLE_SCHEDULED_FACTS=true
# QT_SINGLE_NODE_ENABLE_TRADE_STREAMS=true
# QT_SINGLE_NODE_ENABLE_L2_STREAMS=true
# QT_SINGLE_NODE_INSTRUMENT_MANIFEST=/app/config/market_data/coinbase_perpetual_instruments.v1.json
# QT_SINGLE_NODE_OI_POLL_SECONDS=60
# QT_SINGLE_NODE_FUNDING_POLL_SECONDS=60
# Keep this below the Compose five-minute stop grace so terminal archive and
# canonicalization work can finish while the fencing leases remain owned.
# QT_WORKERS_COLLECTORS_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=270

# Every published server port is loopback-only by default. Use SSH tunnels for
# access rather than exposing these ports to the LAN or internet.
# QT_BACKEND_BIND_ADDRESS=127.0.0.1
# QT_BACKEND_PORT=8000
# QT_FRONTEND_BIND_ADDRESS=127.0.0.1
# QT_FRONTEND_PORT=5173
# QT_FRONTEND_V2_BIND_ADDRESS=127.0.0.1
# QT_FRONTEND_V2_PORT=5174
# QT_PGADMIN_BIND_ADDRESS=127.0.0.1
# QT_PGADMIN_PORT=8080
# QT_GRAFANA_BIND_ADDRESS=127.0.0.1
# QT_GRAFANA_PORT=3000
# QT_ALLOY_BIND_ADDRESS=127.0.0.1
# QT_ALLOY_PORT=12345
# QT_DOCKER_STORAGE_ROOT=/var/lib/docker

# Rebuild the fixed TimescaleDB image only during planned database-engine
# maintenance; ordinary application releases preserve it and its named volume.
# QT_REBUILD_DATABASE_IMAGE=1

###############################################################################
# Optional IBKR Gateway profile
###############################################################################

# Leave disabled until paper-trading connectivity is intentionally admitted.
# QT_SINGLE_NODE_PROFILES=broker
# IBKR_TWS_USERNAME=replace-with-ibkr-username
# IBKR_TWS_PASSWORD=replace-with-ibkr-password
# IBKR_TRADING_MODE=paper
# IBKR_READONLY_API=yes
# IBKR_GATEWAY_PORT=4002
# IBKR_GATEWAY_LIVE_PORT=4001
# IBKR_VNC_PORT=5900
